---

import '../styles/global.css';
import { Github, Linkedin, Mail } from "@lucide/astro";
import Link from '../components/Link.astro';
import EmailLink from '../components/EmailLink.astro';
import AppTile from '../components/AppTile.astro';
import { FancyNodes } from '../components/FancyNodes';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Eik Hvattum Røgeberg | Portfolio</title>
	</head>
	<body class="font-sans flex flex-col items-center justify-center min-h-screen bg-[#f9f9f9] m-0">
		<div class="absolute top-0 left-0 w-full h-full pointer-events-none z-[-1]">
			<FancyNodes client:load />
		</div>
		<main class="bg-white p-8 md:p-12 rounded-2xl shadow-lg text-center">
			<p>Hi! I'm</p>
			<h1 class="mb-2 text-3xl font-bold">Eik Hvattum Røgeberg</h1>
			<p class="mb-6 text-gray-500">Welcome to my portfolio page!</p>
			<nav class="flex gap-6 justify-center">
				<Link
					href="https://github.com/eikhr" 
					colorClass="text-[#24292f]"
					label="GitHub"
				>
					<Github slot="icon" />
				</Link>
				<Link 
					href="https://www.linkedin.com/in/eik-hvattum-rogeberg/" 
					colorClass="text-[#0077b5]"
					label="LinkedIn"
				>
					<Linkedin slot="icon" />
				</Link>
				<EmailLink
					user="eik"
					domain="eikhr.no"
					colorClass="text-[#c2410c]"
					label="Email"
				>
					<Mail slot="icon" />
				</EmailLink>
			</nav>
			<hr class="my-8 border-gray-200" />
			<section>
				<div class="flex flex-wrap gap-4 justify-center">
					<AppTile
						href="/sourdough/"
						name="Sourdough"
						bgClass="bg-[#F6F1E7] ring-1 ring-inset ring-[#D8CBB5]"
					>
						<!-- Same loaf mark as the header of the sourdough page -->
						<svg slot="icon" class="w-14 h-9" viewBox="0 0 140 90" fill="none" aria-hidden="true">
							<path d="M15 58C12 32 34 12 68 11C104 8 129 30 127 55C126 72 109 79 72 79C37 80 18 73 15 58Z" fill="#CB9148" stroke="#70441F" stroke-width="4" />
							<path d="M42 28C34 37 32 46 35 53M66 22C55 33 53 45 57 57M91 24C80 33 77 45 80 57M111 34C103 40 99 47 100 53" stroke="#F8E5B9" stroke-width="8" stroke-linecap="round" />
						</svg>
					</AppTile>
				</div>
			</section>
		</main>
	</body>
</html>
