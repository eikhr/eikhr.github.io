---

import '../styles/global.css';
import { Github, Linkedin, Mail, Wheat } from "@lucide/astro";
import Link from '../components/Link.astro';
import EmailLink from '../components/EmailLink.astro';
import AppTile from '../components/AppTile.astro';
import { FancyNodes } from '../components/FancyNodes';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Eik Hvattum Røgeberg | Portfolio</title>
	</head>
	<body class="font-sans flex flex-col items-center justify-center min-h-screen bg-[#f9f9f9] m-0">
		<div class="absolute top-0 left-0 w-full h-full pointer-events-none z-[-1]">
			<FancyNodes client:load />
		</div>
		<main class="bg-white p-8 md:p-12 rounded-2xl shadow-lg text-center">
			<p>Hi! I'm</p>
			<h1 class="mb-2 text-3xl font-bold">Eik Hvattum Røgeberg</h1>
			<p class="mb-6 text-gray-500">Welcome to my portfolio page!</p>
			<nav class="flex gap-6 justify-center">
				<Link
					href="https://github.com/eikhr" 
					colorClass="text-[#24292f]"
					label="GitHub"
				>
					<Github slot="icon" />
				</Link>
				<Link 
					href="https://www.linkedin.com/in/eik-hvattum-rogeberg/" 
					colorClass="text-[#0077b5]"
					label="LinkedIn"
				>
					<Linkedin slot="icon" />
				</Link>
				<EmailLink
					user="eik"
					domain="eikhr.no"
					colorClass="text-[#c2410c]"
					label="Email"
				>
					<Mail slot="icon" />
				</EmailLink>
			</nav>
			<hr class="my-8 border-gray-200" />
			<section>
				<h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-gray-400">Tools I've built</h2>
				<div class="flex flex-wrap gap-4 justify-center">
					<AppTile
						href="/sourdough/"
						name="Sourdough"
						bgClass="bg-gradient-to-br from-amber-400 to-orange-600"
					>
						<Wheat slot="icon" size={40} stroke-width={1.75} />
					</AppTile>
				</div>
			</section>
		</main>
	</body>
</html>
